from tkinter import *


window = Tk()
window.minsize(width=500, height=300)
window.title("Mile to Km Converter")
window.config(padx=100, pady=200)


def converter():
    new = int(value.get())
    convert = new * 1.609344
    rounding = round(convert,2)
    answer_label.config(text=rounding)


""" BUTTON """
calculate = Button(text="Calculate",command=converter)
calculate.grid(column=2,row=2)

""" Equal LABEL"""
text= Label(text="is equal to", font= ("Arial", 12, "bold"))
text.grid(column=1,row=1)
text.config(padx=20,pady=-30)


""" Answer label"""
answer_label = Label(text="")
answer_label.grid(column=2,row=1)

""" Kilometer label """
km = Label(text="Km", font=("Arial",12,"bold"))
km.grid(column=3,row=1)


""" Input box """
value = Entry(width=20)
value.grid(column=2, row=0)


""" MILES LABEL """
miles = Label(text="Miles",font=("Arail", 12, "bold"))
miles.grid(column=3,row=0)
miles.config(padx=10)


window.mainloop()





